[Unit]
Description=Futbol Tahmin Telegram Botu
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/futbol_bot
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/home/ubuntu
ExecStart=/home/ubuntu/futbol_bot/.venv/bin/python -m bot.telegram_bot
Restart=always
RestartSec=10
StandardOutput=append:/home/ubuntu/futbol_bot/logs/bot.log
StandardError=append:/home/ubuntu/futbol_bot/logs/bot.log

[Install]
WantedBy=multi-user.target
